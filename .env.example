# Jaspion V1 - Configurações de Ambiente
# Portas da Aplicação
PORT=6171
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_PORT=6172
FRONTEND_URL=http://localhost:6172

# Banco de Dados (SQLite local)
DATABASE_URL=./data/jaspion.db

# Segurança e Sessão
SESSION_SECRET=mudar-em-producao-jaspion-secret-chave-min-32-chars
COOKIE_SECRET=mudar-em-producao-cookie-secret-min-32-chars
SESSION_MAX_AGE_HOURS=12

# Usuário Administrador Inicial (Seed)
DEFAULT_ADMIN_EMAIL=admin@microset.local
DEFAULT_ADMIN_NAME=Administrador CCO
DEFAULT_ADMIN_PASSWORD=Admin@123

# Integração Znuny (Somente Leitura)
ZNUNY_MOCK=true
ZNUNY_API_URL=https://znuny.microset.com.br/otrs/nph-genericinterface.pl/Webservice/JaspionAPI
ZNUNY_API_USER=jaspion_read
ZNUNY_API_TOKEN=token_znuny_aqui
ZNUNY_SYNC_INTERVAL_MINUTES=5

# Backups
BACKUP_DIR=./data/backups
NETWORK_BACKUP_PATH=\\172.16.0.49\Jaspion_Backups
